---
import { Icon } from "astro-icon/components";

interface Props {
  icon?: string;
  imgSrc?: string;
  label: string;
  class?: string;
}

const { icon, imgSrc, label, class: className = "h-5 w-5" } = Astro.props;
---

{
  imgSrc ? (
    <img src={imgSrc} alt={label} class={className} />
  ) : (
    <Icon name={icon} class={className} />
  )
}
