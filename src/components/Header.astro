---

---

<header
	class="fixed top-0 left-0 right-0 z-50 bg-white/80 dark:bg-slate-900/80 backdrop-blur-sm border-b border-slate-200 dark:border-slate-800"
>
	<div class="max-w-4xl mx-auto px-6 py-4 flex justify-between items-center">
		<a href="#" class="text-xl font-bold text-slate-900 dark:text-white"
			>makinosp</a
		>
		<nav class="flex items-center gap-6 text-sm">
			<a
				href="#about"
				class="text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors"
				>About</a
			>
			<a
				href="#tech"
				class="text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors"
				>Tech Stack</a
			>
			<a
				href="#projects"
				class="text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors"
				>Projects</a
			>
			<a
				href="#stats"
				class="text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors"
				>Stats</a
			>
			<button
				id="theme-toggle"
				class="p-2 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors"
			>
				<svg
					id="theme-icon"
					xmlns="http://www.w3.org/2000/svg"
					class="h-5 w-5"
					fill="none"
					viewBox="0 0 24 24"
					stroke="currentColor"
				>
					<path
						id="theme-icon-path"
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						d="M12 3v1m0 16v1m8.66-10H21m-3.34 0h-1.34M5.34 12H4m17 0a9 9 0 11-18 0 9 9 0 0118 0z"
					></path>
				</svg>
			</button>
		</nav>
	</div>
</header>

<script>
	const themeToggle = document.getElementById("theme-toggle");
	const themeIcon = document.getElementById("theme-icon-path");
	const isDark = () => document.documentElement.classList.contains("dark");

	const updateIcon = () => {
		if (isDark()) {
			themeIcon.setAttribute(
				"d",
				"M12 3v1m0 16v1m8.66-10H21m-3.34 0h-1.34M5.34 12H4m17 0a9 9 0 11-18 0 9 9 0 0118 0z",
			);
		} else {
			themeIcon.setAttribute(
				"d",
				"M12 3v1m0 16v1m8.66-10H21m-3.34 0h-1.34M5.34 12H4m17 0a9 9 0 11-18 0 9 9 0 0118 0z",
			);
		}
	};

	themeToggle.addEventListener("click", () => {
		document.documentElement.classList.toggle("dark");
		updateIcon();
	});

	updateIcon();
</script>
