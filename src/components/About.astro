---
import Section from "./Section.astro";
import { DISPLAY_NAME } from "../lib/site.ts";
---

<Section id="about" title="About Me" variant="muted">
	<div class="prose prose-slate dark:prose-invert max-w-none">
		<p class="about-text">
			Hi! I'm <strong class="about-emphasis">{DISPLAY_NAME}</strong>, a Software
			Engineer based in Tokyo.
		</p>
		<p class="about-text mt-4">
			My core philosophy is centered around <strong class="about-emphasis"
				>code quality</strong
			> and
			<strong class="about-emphasis">long-term maintainability</strong>. I
			believe that well-crafted code should be readable, testable, and
			sustainable over time.
		</p>
		<p class="about-text mt-4">
			I'm currently focused on web development and building scalable
			applications.
		</p>
	</div>
</Section>
