---
import Section from "./Section.astro";
import { PROFILE_NAME } from "../lib/site.ts";
---

<Section id="about" title="About Me" variant="muted">
	<div class="prose prose-slate dark:prose-invert max-w-none">
		<p class="about-text">
			Hi! I'm <strong class="about-emphasis">{PROFILE_NAME}</strong>, a Software
			Engineer based in Tokyo.
		</p>
		<p class="about-text mt-4">
			I mainly develop Node.js backend servers in TypeScript for business
			projects.
		</p>
		<p class="about-text mt-4">
			In personal projects, I build tools for household finance and develop 2D
			games.
		</p>
		<p class="about-text mt-4">
			My approach is largely specification-driven, leveraging AI agents—though I
			never lose the joy of writing code myself.
		</p>
	</div>
</Section>

<style>
	@reference "../styles/global.css";

	.about-text {
		@apply text-lg text-slate-600 dark:text-slate-300 leading-relaxed;
	}

	.about-emphasis {
		@apply text-slate-900 dark:text-white;
	}
</style>
