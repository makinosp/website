---
import Container from "./Container.astro";
import ExternalLink from "./ExternalLink.astro";
import SocialIcon from "./SocialIcon.astro";
import { SOCIAL_LINKS } from "../lib/social.ts";
import {
	AVATAR_URL,
	DISPLAY_NAME_COMPACT,
	PROFILE_NAME,
	PROFILE_NAME_JA,
} from "../lib/site.ts";
---

<section class="min-h-screen flex items-center justify-center pt-16">
	<Container class="py-20 text-center">
		<div class="avatar-frame relative inline-block mb-8 rounded-full shadow-xl">
			<div class="avatar-shimmer">
				<img
					src={AVATAR_URL}
					alt={DISPLAY_NAME_COMPACT}
					class="block w-32 h-32 rounded-full object-cover border-4 border-slate-200 dark:border-slate-700"
				/>
			</div>
		</div>
		<h1
			class="heading-shimmer relative block w-fit mx-auto mb-4 text-5xl md:text-6xl font-extrabold"
			data-text={DISPLAY_NAME_COMPACT}
		>
			<span class="text-slate-900 dark:text-white">{PROFILE_NAME}</span>
			<span class="text-yellow-400 dark:text-yellow-200">{PROFILE_NAME_JA}</span
			>
		</h1>
		<p
			class="text-xl text-slate-600 dark:text-slate-300 mb-8 max-w-2xl mx-auto"
		>
			Software Engineer based in Tokyo, focusing on Web development.
		</p>
		<div class="flex flex-wrap justify-center gap-4 mb-8">
			{
				SOCIAL_LINKS.map((link) => (
					<ExternalLink href={link.href} ariaLabel={link.label} variant="pill">
						<SocialIcon
							icon={link.icon}
							imgSrc={link.imgSrc}
							label={link.label}
						/>
						{link.label}
					</ExternalLink>
				))
			}
		</div>
	</Container>
</section>
