<section class="min-h-screen flex items-center justify-center pt-16">
	<div class="max-w-4xl mx-auto px-6 py-20 text-center">
		<div class="mb-8">
			<img
				src="https://avatars.githubusercontent.com/u/130737299?v=4"
				alt="Makinon (まきのん)"
				class="w-32 h-32 rounded-full mx-auto mb-6 object-cover border-4 border-slate-200 dark:border-slate-700 shadow-xl"
			/>
		</div>
		<h1 class="text-5xl md:text-6xl font-extrabold mb-4">
			<span class="text-slate-900 dark:text-white">Makinon</span>
			<span class="text-blue-600 dark:text-blue-400">(まきのん)</span>
		</h1>
		<p
			class="text-xl text-slate-600 dark:text-slate-300 mb-8 max-w-2xl mx-auto"
		>
			Software Engineer based in Tokyo, focusing on Web development.
		</p>
		<div class="flex flex-wrap justify-center gap-4 mb-8">
			<a
				href="https://github.com/makinosp"
				target="_blank"
