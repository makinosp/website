---
import { Icon } from "astro-icon/components";
import LicensesModal from "./LicensesModal.astro";
---

<footer class="py-12 border-t border-slate-200 dark:border-slate-800">
	<div class="max-w-4xl mx-auto px-6">
		<div class="flex flex-col md:flex-row justify-between items-center">
			<div class="flex flex-col items-center md:items-start gap-1 mb-4 md:mb-0">
				<p class="text-sm text-slate-500 dark:text-slate-400">
					&copy; 2026 Makinon (まきのん). All rights reserved.
				</p>
				<button
					id="licenses-open"
					type="button"
					class="text-sm text-slate-500 dark:text-slate-400 underline decoration-slate-300 dark:decoration-slate-600 underline-offset-2 hover:text-slate-900 dark:hover:text-white transition-colors"
				>
					Third-party licenses
				</button>
			</div>
			<div class="flex flex-wrap justify-center gap-4">
				<a
					href="https://bsky.app/profile/mknn.jp"
					target="_blank"
					rel="noopener noreferrer"
					class="text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors"
					aria-label="Bluesky"
				>
					<Icon name="simple-icons:bluesky" class="h-5 w-5" />
				</a>
				<a
					href="https://discord.com/channels/@me/257326164996128770"
					target="_blank"
					rel="noopener noreferrer"
					class="text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors"
					aria-label="Discord"
				>
					<Icon name="simple-icons:discord" class="h-5 w-5" />
				</a>
				<a
					href="https://www.duolingo.com/profile/makinosp"
					target="_blank"
					rel="noopener noreferrer"
					class="text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors"
					aria-label="Duolingo"
				>
					<Icon name="simple-icons:duolingo" class="h-5 w-5" />
				</a>
				<a
					href="https://github.com/makinosp"
					target="_blank"
					rel="noopener noreferrer"
					class="text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors"
					aria-label="GitHub"
				>
					<Icon name="simple-icons:github" class="h-5 w-5" />
				</a>
				<a
					href="https://www.instagram.com/makinosp/"
					target="_blank"
					rel="noopener noreferrer"
					class="text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors"
					aria-label="Instagram"
				>
					<Icon name="simple-icons:instagram" class="h-5 w-5" />
				</a>
				<a
					href="https://open.spotify.com/user/sheeptech"
					target="_blank"
					rel="noopener noreferrer"
					class="text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors"
					aria-label="Spotify"
				>
					<Icon name="simple-icons:spotify" class="h-5 w-5" />
				</a>
				<a
					href="https://steamcommunity.com/id/makinosp/"
					target="_blank"
					rel="noopener noreferrer"
					class="text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors"
					aria-label="Steam"
				>
					<Icon name="simple-icons:steam" class="h-5 w-5" />
				</a>
				<a
					href="https://t.me/mknnjp"
					target="_blank"
					rel="noopener noreferrer"
					class="text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors"
					aria-label="Telegram"
				>
					<Icon name="simple-icons:telegram" class="h-5 w-5" />
				</a>
				<a
					href="https://www.threads.net/@mknn.jp"
					target="_blank"
					rel="noopener noreferrer"
					class="text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors"
					aria-label="Threads"
				>
					<Icon name="simple-icons:threads" class="h-5 w-5" />
				</a>
				<a
					href="https://vrchat.com/home/user/usr_d23319bc-086d-45e8-83ff-fb9ecb026d1f"
					target="_blank"
					rel="noopener noreferrer"
					class="text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors"
					aria-label="VRChat"
				>
					<img src="/VRC.svg" alt="VRChat" class="h-5 w-5" />
				</a>
				<a
					href="https://x.com/mknnjp"
					target="_blank"
					rel="noopener noreferrer"
					class="text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors"
					aria-label="X"
				>
					<Icon name="simple-icons:x" class="h-5 w-5" />
				</a>
			</div>
		</div>
	</div>
	<LicensesModal />
</footer>
