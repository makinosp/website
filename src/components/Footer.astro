---
import Container from "./Container.astro";
import ExternalLink from "./ExternalLink.astro";
import SocialIcon from "./SocialIcon.astro";
import LicensesModal from "./LicensesModal.astro";
import { SOCIAL_LINKS } from "../lib/social.ts";
import { COPYRIGHT_YEAR, DISPLAY_NAME } from "../lib/site.ts";
---

<footer class="py-12 border-t border-slate-200 dark:border-slate-800">
	<Container>
		<div class="flex flex-col md:flex-row justify-between items-center">
			<div class="flex flex-col items-center md:items-start gap-1 mb-4 md:mb-0">
				<p class="text-sm text-slate-500 dark:text-slate-400">
					&copy; {COPYRIGHT_YEAR} {DISPLAY_NAME}. All rights reserved.
				</p>
				<button
					id="licenses-open"
					type="button"
					class="text-sm text-slate-500 dark:text-slate-400 underline decoration-slate-300 dark:decoration-slate-600 underline-offset-2 hover:text-slate-900 dark:hover:text-white transition-colors"
				>
					Third-party licenses
				</button>
			</div>
			<div class="flex flex-wrap justify-center gap-4">
				{
					SOCIAL_LINKS.map((link) => (
						<ExternalLink
							href={link.href}
							ariaLabel={link.label}
							variant="muted"
						>
							<SocialIcon
								icon={link.icon}
								imgSrc={link.imgSrc}
								label={link.label}
							/>
						</ExternalLink>
					))
				}
			</div>
		</div>
	</Container>
	<LicensesModal />
</footer>
