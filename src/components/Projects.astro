---
import { Icon } from "astro-icon/components";
import Section from "./Section.astro";
import Card from "./Card.astro";
import Badge from "./Badge.astro";
import { USERNAME } from "../lib/site.ts";
import type { Dictionary } from "../i18n/dictionary.ts";
import { formatTemplate } from "../i18n/index.ts";

interface Props {
	projects?: Dictionary["projects"];
}

const { projects } = Astro.props;

interface Project {
	name: string;
	language: string;
	languageColor: "blue" | "orange";
	stars?: number;
	forks?: number;
}

const PROJECTS: Project[] = [
	{
		name: "utopia",
		language: "Rust",
		languageColor: "orange",
		stars: 1,
	},
	{
		name: "luminescence",
		language: "TypeScript",
		languageColor: "blue",
	},
	{
		name: "xiangke",
		language: "Rust",
		languageColor: "orange",
		stars: 1,
		forks: 1,
	},
	{
		name: "pr-agent-runner",
		language: "TypeScript",
		languageColor: "blue",
	},
];

const title = projects?.title ?? "Projects";
const descriptions = projects?.descriptions ?? {};
const viewOnGitHubTemplate =
	projects?.viewOnGitHubTemplate ?? "View {name} on GitHub";
const starsTemplate = projects?.starsTemplate ?? "{count} star";
const forksTemplate = projects?.forksTemplate ?? "{count} fork";
---

<Section id="projects" title={title} variant="muted">
	<div class="space-y-6">
		{
			PROJECTS.map((project) => (
				<Card
					as="a"
					hoverable
					href={`https://github.com/${USERNAME}/${project.name}`}
					target="_blank"
					rel="noopener noreferrer"
					ariaLabel={formatTemplate(viewOnGitHubTemplate, {
						name: project.name,
					})}
				>
					<div class="flex justify-between items-start mb-3">
						<h3 class="text-xl font-semibold text-slate-900 dark:text-white">
							{project.name}
						</h3>
						<Badge color={project.languageColor} size="sm">
							{project.language}
						</Badge>
					</div>
					<p class="text-slate-600 dark:text-slate-300 mb-3">
						{descriptions[project.name] ?? ""}
					</p>
					{(project.stars || project.forks) && (
						<div class="flex items-center gap-4 text-sm text-slate-500 dark:text-slate-400">
							{project.stars ? (
								<span class="flex items-center gap-1">
									<Icon name="lucide:star" class="h-4 w-4" />
									{formatTemplate(starsTemplate, { count: project.stars })}
								</span>
							) : null}
							{project.forks ? (
								<span class="flex items-center gap-1">
									<Icon name="lucide:git-fork" class="h-4 w-4" />
									{formatTemplate(forksTemplate, { count: project.forks })}
								</span>
							) : null}
						</div>
					)}
				</Card>
			))
		}
	</div>
</Section>
