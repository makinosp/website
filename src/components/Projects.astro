---

---

<section id="projects" class="py-20 bg-slate-50 dark:bg-slate-800/30">
	<div class="max-w-4xl mx-auto px-6">
		<h2 class="text-3xl font-bold mb-8 text-slate-900 dark:text-white">
			Projects
		</h2>

		<div class="space-y-6">
			<!-- Project 1 -->
			<div
				class="bg-white dark:bg-slate-800 rounded-xl p-6 border border-slate-200 dark:border-slate-700 hover:shadow-lg transition-shadow"
			>
				<div class="flex justify-between items-start mb-3">
					<h3 class="text-xl font-semibold text-slate-900 dark:text-white">
						<a
							href="https://github.com/makinosp/utopia"
							target="_blank"
							rel="noopener noreferrer"
							class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
						>
							utopia
						</a>
					</h3>
					<span
						class="px-2 py-1 text-xs font-medium bg-orange-100 dark:bg-orange-900/30 text-orange-800 dark:text-orange-300 rounded"
					>
						Rust
					</span>
				</div>
				<p class="text-slate-600 dark:text-slate-300 mb-3">
					A lightweight, self-hostable personal finance API with partial
					Firefly-III compatibility, written in Rust.
				</p>
				<div
					class="flex items-center gap-4 text-sm text-slate-500 dark:text-slate-400"
				>
					<span class="flex items-center gap-1">
						<svg
							xmlns="http://www.w3.org/2000/svg"
							class="h-4 w-4"
							fill="currentColor"
							viewBox="0 0 24 24"
						>
							<path
								d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"
							></path>
						</svg>
						1 star
					</span>
				</div>
			</div>

			<!-- Project 2 -->
			<div
				class="bg-white dark:bg-slate-800 rounded-xl p-6 border border-slate-200 dark:border-slate-700 hover:shadow-lg transition-shadow"
			>
				<div class="flex justify-between items-start mb-3">
					<h3 class="text-xl font-semibold text-slate-900 dark:text-white">
						<a
							href="https://github.com/makinosp/luminescence"
							target="_blank"
							rel="noopener noreferrer"
							class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
						>
							luminescence
						</a>
					</h3>
					<span
						class="px-2 py-1 text-xs font-medium bg-blue-100 dark:bg-blue-900/30 text-blue-800 dark:text-blue-300 rounded"
					>
						TypeScript
					</span>
				</div>
				<p class="text-slate-600 dark:text-slate-300 mb-3">
					A TypeScript-based multi-client application suite for Firefly III,
					providing shared personal finance management logic across mobile, web,
					and CLI platforms.
				</p>
			</div>

			<!-- Project 3 -->
			<div
				class="bg-white dark:bg-slate-800 rounded-xl p-6 border border-slate-200 dark:border-slate-700 hover:shadow-lg transition-shadow"
			>
				<div class="flex justify-between items-start mb-3">
					<h3 class="text-xl font-semibold text-slate-900 dark:text-white">
						<a
							href="https://github.com/makinosp/xiangke"
							target="_blank"
							rel="noopener noreferrer"
							class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
						>
							xiangke
						</a>
					</h3>
					<span
						class="px-2 py-1 text-xs font-medium bg-orange-100 dark:bg-orange-900/30 text-orange-800 dark:text-orange-300 rounded"
					>
						Rust
					</span>
				</div>
				<p class="text-slate-600 dark:text-slate-300 mb-3">
					Xiangke (相剋; xiāngkè) is a turn-based battle game with menu-driven
					combat, inspired by Romance of the Three Kingdoms.
				</p>
				<div
					class="flex items-center gap-4 text-sm text-slate-500 dark:text-slate-400"
				>
					<span class="flex items-center gap-1">
						<svg
							xmlns="http://www.w3.org/2000/svg"
							class="h-4 w-4"
							fill="currentColor"
							viewBox="0 0 24 24"
						>
							<path
								d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"
							></path>
						</svg>
						1 star
					</span>
					<span class="flex items-center gap-1">
						<svg
							xmlns="http://www.w3.org/2000/svg"
							class="h-4 w-4"
							fill="currentColor"
							viewBox="0 0 16 16"
						>
							<path
								d="M5 5.372v.878c0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75v-.878a2.25 2.25 0 111.5 0v.878a2.25 2.25 0 01-2.25 2.25h-1.5v2.128a2.251 2.251 0 11-1.5 0V8.5h-1.5A2.25 2.25 0 013 6.25v-.878a2.25 2.25 0 112 0zM5 3.25a.75.75 0 100-1.5.75.75 0 000 1.5zm6.75.75a.75.75 0 100-1.5.75.75 0 000 1.5zm-3 12.75a.75.75 0 100-1.5.75.75 0 000 1.5z"
							></path>
						</svg>
						1 fork
					</span>
				</div>
			</div>

			<!-- Project 4 -->
			<div
				class="bg-white dark:bg-slate-800 rounded-xl p-6 border border-slate-200 dark:border-slate-700 hover:shadow-lg transition-shadow"
			>
				<div class="flex justify-between items-start mb-3">
					<h3 class="text-xl font-semibold text-slate-900 dark:text-white">
						<a
							href="https://github.com/makinosp/pr-agent-runner"
							target="_blank"
							rel="noopener noreferrer"
							class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
						>
							pr-agent-runner
						</a>
					</h3>
					<span
						class="px-2 py-1 text-xs font-medium bg-blue-100 dark:bg-blue-900/30 text-blue-800 dark:text-blue-300 rounded"
					>
						TypeScript
					</span>
				</div>
				<p class="text-slate-600 dark:text-slate-300 mb-3">
					AI-powered PR review automation built on OpenCodeReview (OCR) and a
					small TypeScript CLI that posts reviews and answers @mention commands
					on GitHub.
				</p>
			</div>
		</div>
	</div>
</section>
