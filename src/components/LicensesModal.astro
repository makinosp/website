---
import ExternalLink from "./ExternalLink.astro";
import { LICENSE_CATEGORIES } from "../lib/licenses.ts";
import type { Dictionary } from "../i18n/dictionary.ts";

interface Props {
  licensesModal?: Dictionary["licensesModal"];
}

const { licensesModal } = Astro.props;

const title = licensesModal?.title ?? "Third-party licenses";
const description =
  licensesModal?.description ??
  "This site is built with open source software. Thanks to the maintainers and contributors of these projects.";
const closeLabel =
  licensesModal?.closeLabel ?? "Close third-party licenses dialog";
const categoryTitles = licensesModal?.categories ?? {
  runtime: "Runtime",
  buildTooling: "Build tooling",
  fonts: "Fonts",
  icons: "Icons",
};

const CATEGORY_TITLE_KEYS = [
  "runtime",
  "buildTooling",
  "fonts",
  "icons",
] as const;

const getCategoryTitle = (index: number, fallback: string): string => {
  const key = CATEGORY_TITLE_KEYS[index];
  return key ? (categoryTitles[key] ?? fallback) : fallback;
};

const categoryHeadingClass =
  "mb-2 text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400";
const licenseNoteClass = "text-slate-500 dark:text-slate-400";
---

<dialog
  id="licenses-modal"
  aria-labelledby="licenses-modal-title"
  class="m-auto w-[calc(100%-2rem)] max-w-2xl rounded-2xl border border-slate-200 bg-white p-0 text-slate-900 shadow-xl backdrop:bg-slate-900/50 backdrop:backdrop-blur-sm dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100"
>
  <div class="max-h-[80vh] overflow-y-auto p-6 sm:p-8">
    <div class="mb-6 flex items-start justify-between gap-4">
      <div>
        <h2
          id="licenses-modal-title"
          class="text-xl font-bold text-slate-900 dark:text-white"
        >
          {title}
        </h2>
        <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
          {description}
        </p>
      </div>
      <button
        id="licenses-close"
        type="button"
        aria-label={closeLabel}
        class="rounded-lg bg-slate-100 p-2 text-slate-600 transition-colors hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="h-5 w-5"
          aria-hidden="true"
        >
          <path d="M18 6 6 18"></path>
          <path d="m6 6 12 12"></path>
        </svg>
      </button>
    </div>

    <div class="space-y-6 text-sm">
      {
        LICENSE_CATEGORIES.map((category, index) => (
          <section>
            <h3 class={categoryHeadingClass}>
              {getCategoryTitle(index, category.title)}
            </h3>
            <ul class="space-y-2">
              {category.items.map((item) => (
                <li>
                  <ExternalLink href={item.href} variant="underline">
                    {item.label}
                  </ExternalLink>{" "}
                  <span class={licenseNoteClass}>{item.note}</span>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</dialog>

<script>
  const modal = document.getElementById("licenses-modal");
  const openButton = document.getElementById("licenses-open");
  const closeButton = document.getElementById("licenses-close");

  const isDialog = (element: Element | null): element is HTMLDialogElement =>
    element instanceof HTMLDialogElement;

  openButton?.addEventListener("click", () => {
    if (isDialog(modal)) modal.showModal();
  });

  closeButton?.addEventListener("click", () => {
    if (isDialog(modal)) modal.close();
  });

  modal?.addEventListener("click", (event) => {
    if (isDialog(modal) && event.target === modal) modal.close();
  });
</script>
