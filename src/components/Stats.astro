---
import Section from "./Section.astro";
import Card from "./Card.astro";
import ExternalLink from "./ExternalLink.astro";
import { fetchTopRepos } from "../lib/github.ts";
import type { Dictionary } from "../i18n/dictionary.ts";

interface Props {
	stats?: Dictionary["stats"];
}

const { stats } = Astro.props;

const topRepos = await fetchTopRepos();

const title = stats?.title ?? "GitHub Stats";
const recentPushesHeading = stats?.recentPushes ?? "Recent pushes";
const pushesSuffix = stats?.pushesSuffix ?? "pushes in the last 7 days";
const activityHeading = stats?.activity ?? "Activity";
const topReposHeading = stats?.topRepos ?? "Top Repositories";
const loadingPushes = stats?.loadingPushes ?? "Loading recent pushes…";
const loadingActivity = stats?.loadingActivity ?? "Loading activity…";
const loadError =
	stats?.loadError ?? "Could not load GitHub activity. Please try again later.";
const activityLabels = stats?.labels ?? {
	commits: "Commits",
	pullRequests: "Pull requests",
	codeReview: "Code review",
	issues: "Issues",
};

const statHeadingClass =
	"text-lg font-semibold mb-3 text-slate-900 dark:text-white";
const skeletonBar =
	"inline-block h-4 w-24 animate-pulse rounded bg-slate-200 dark:bg-slate-700";
---

<Section id="stats" title={title}>
	<div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
		<Card>
			<h3 class={statHeadingClass}>{recentPushesHeading}</h3>
			<p
				id="github-push-count"
				class="text-3xl font-bold text-blue-600 dark:text-blue-400"
				aria-live="polite"
			>
				<span class={skeletonBar} aria-hidden="true"></span>
				<span class="sr-only">{loadingPushes}</span>
			</p>
			<p class="text-sm text-slate-500 dark:text-slate-400 mt-1">
				{pushesSuffix}
			</p>
			<p
				id="github-stats-error"
				class="text-sm text-red-600 dark:text-red-400 mt-2"
				hidden
			>
			</p>
		</Card>
		<Card>
			<h3 class={statHeadingClass}>{activityHeading}</h3>
			<div
				id="github-activity"
				class="space-y-2 text-sm"
				aria-live="polite"
				data-label-commits={activityLabels.commits}
				data-label-pull-requests={activityLabels.pullRequests}
				data-label-code-review={activityLabels.codeReview}
				data-label-issues={activityLabels.issues}
				data-load-error={loadError}
			>
				<div class="flex justify-between">
					<span class={skeletonBar} aria-hidden="true"></span>
					<span class={skeletonBar} aria-hidden="true"></span>
				</div>
				<div class="flex justify-between">
					<span class={skeletonBar} aria-hidden="true"></span>
					<span class={skeletonBar} aria-hidden="true"></span>
				</div>
				<div class="flex justify-between">
					<span class={skeletonBar} aria-hidden="true"></span>
					<span class={skeletonBar} aria-hidden="true"></span>
				</div>
				<div class="flex justify-between">
					<span class={skeletonBar} aria-hidden="true"></span>
					<span class={skeletonBar} aria-hidden="true"></span>
				</div>
				<span class="sr-only">{loadingActivity}</span>
			</div>
		</Card>
	</div>

	<Card>
		<h3 class={statHeadingClass}>{topReposHeading}</h3>
		<div class="space-y-3">
			{
				topRepos.map((repo) => (
					<div class="flex items-center justify-between">
						<ExternalLink
							href={repo.htmlUrl}
							variant="none"
							class="text-blue-600 dark:text-blue-400 hover:underline"
						>
							{repo.name}
						</ExternalLink>
						<span class="text-sm text-slate-500 dark:text-slate-400">
							{repo.language}
						</span>
					</div>
				))
			}
		</div>
	</Card>
</Section>

<script>
	import {
		fetchActivityStats,
		loadCachedActivity,
		type ActivityStats,
	} from "../lib/github-client.ts";
	import { USERNAME } from "../lib/site.ts";

	const pushEl = document.getElementById("github-push-count");
	const activityEl = document.getElementById("github-activity");
	const errorEl = document.getElementById("github-stats-error");

	function renderActivity(stats: ActivityStats) {
		if (pushEl) {
			pushEl.textContent = String(stats.recentPushes);
		}
		if (activityEl) {
			const labels = [
				activityEl.dataset.labelCommits ?? "Commits",
				activityEl.dataset.labelPullRequests ?? "Pull requests",
				activityEl.dataset.labelCodeReview ?? "Code review",
				activityEl.dataset.labelIssues ?? "Issues",
			];
			activityEl.innerHTML = "";
			stats.activity.forEach((slice, index) => {
				const row = document.createElement("div");
				row.className = "flex justify-between";

				const label = document.createElement("span");
				label.className = "text-slate-600 dark:text-slate-300";
				label.textContent = labels[index] ?? slice.label;

				const value = document.createElement("span");
				value.className = "text-slate-900 dark:text-white font-medium";
				value.textContent = `${slice.percent}%`;

				row.append(label, value);
				activityEl.append(row);
			});
		}
	}

	function renderError() {
		if (pushEl) {
			pushEl.textContent = "—";
		}
		if (activityEl) {
			activityEl.innerHTML = "";
		}
		if (errorEl) {
			errorEl.textContent =
				activityEl?.dataset.loadError ??
				"Could not load GitHub activity. Please try again later.";
			errorEl.hidden = false;
		}
	}

	async function loadActivity() {
		const cached = loadCachedActivity();
		if (cached) {
			renderActivity(cached);
			return;
		}
		try {
			const stats = await fetchActivityStats(USERNAME);
			renderActivity(stats);
		} catch {
			renderError();
		}
	}

	void loadActivity();
</script>
