---
interface Props {
  href: string;
  ariaLabel?: string;
  variant?: "pill" | "muted" | "underline" | "none";
  class?: string;
}

const {
  href,
  ariaLabel,
  variant = "muted",
  class: className = "",
} = Astro.props;

const variants = {
  pill: "flex items-center gap-2 px-5 py-2.5 bg-slate-100 dark:bg-slate-800 rounded-lg text-slate-700 dark:text-slate-200 hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors",
  muted:
    "text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors",
  underline:
    "font-medium text-slate-900 underline decoration-slate-300 underline-offset-2 hover:decoration-slate-500 dark:text-white dark:decoration-slate-600",
  none: "",
};
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={ariaLabel}
  class={`${variants[variant]}${className ? ` ${className}` : ""}`}
>
  <slot />
</a>
