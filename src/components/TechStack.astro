---
import Section from "./Section.astro";
import Badge from "./Badge.astro";

interface TechItem {
	label: string;
	color:
		| "blue"
		| "orange"
		| "green"
		| "purple"
		| "cyan"
		| "yellow"
		| "red"
		| "indigo"
		| "pink";
}

interface TechCategory {
	title: string;
	items: TechItem[];
}

const CATEGORIES: TechCategory[] = [
	{
		title: "Languages",
		items: [
			{ label: "TypeScript", color: "blue" },
			{ label: "Rust", color: "orange" },
		],
	},
	{
		title: "Frameworks & Tools",
		items: [
			{ label: "Node.js", color: "green" },
			{ label: "Fastify", color: "purple" },
			{ label: "Astro", color: "cyan" },
			{ label: "Tailwind CSS", color: "yellow" },
		],
	},
	{
		title: "Other",
		items: [
			{ label: "Docker", color: "red" },
			{ label: "PostgreSQL", color: "indigo" },
			{ label: "Git", color: "pink" },
		],
	},
];

const subheadingClass =
	"text-xl font-semibold mb-4 text-slate-800 dark:text-slate-200";
---

<Section id="tech" title="Tech Stack">
	{
		CATEGORIES.map((category, index) => (
			<div class={index < CATEGORIES.length - 1 ? "mb-10" : ""}>
				<h3 class={subheadingClass}>{category.title}</h3>
				<div class="flex flex-wrap gap-3">
					{category.items.map((item) => (
						<Badge color={item.color}>{item.label}</Badge>
					))}
				</div>
			</div>
		))
	}
</Section>
