	"text-xl font-semibold mb-4 text-slate-800 dark:text-slate-200";
---

<Section id="tech" title={title}>
	<div class="mb-10">
		<h3 class={subheadingClass}>{tech?.categories.languages ?? "Languages"}</h3>
		<div class="flex flex-wrap gap-3">
			{
				LANGUAGES.map((item) => (
					<img src={item.src} alt={item.label} class="h-10" />
				))
			}
		</div>
	</div>
	<div>
		<h3 class={subheadingClass}>
			{tech?.categories.frameworksTools ?? "Frameworks & Tools"}
		</h3>
		<div class="flex flex-wrap gap-3">
			{
				FRAMEWORKS_TOOLS.map((item) => (
					<img src={item.src} alt={item.label} class="h-10" />
				))
			}
		</div>
	</div>
</Section>
